{
  "name": "llama-agent-web-example",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "build:document-editor": "vite build --config vite.document-editor.config.ts && node scripts/embed-document-editor.mjs",
    "test": "vitest run",
    "build:investigation-workspace": "vite build --config vite.investigation.config.ts && node scripts/embed-investigation-workspace.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "@toast-ui/editor": "3.2.2",
    "cytoscape": "3.35.0",
    "dompurify": "3.4.18",
    "vue": "^3.5.45"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@vitejs/plugin-vue": "^6.0.11",
    "typescript": "^5.8.3",
    "vite": "^7.3.8",
    "vitest": "^5.1.0",
    "vue-tsc": "^3.3.14"
  },
  "overrides": {
    "@toast-ui/editor": {
      "dompurify": "$dompurify"
    }
  }
}
