{
  "schema_version": 1,
  "runtime": {
    "default_mode": "agent",
    "thinking_mode": "reflective",
    "adaptation": {
      "capture": true,
      "collection_allowed": true,
      "flydelta": {
        "enabled": true,
        "worker_count": 1,
        "queue_path": "var/agent/flydelta/jobs"
      },
      "max_evidence": 16,
      "backend": "jsonl",
      "transaction_path": "var/agent/learning.jsonl",
      "stable_model_facing_tools": [
        "data.inspect"
      ],
      "domains": {
        "planning": true,
        "tool_use": false,
        "research": true,
        "procedure_learning": true,
        "families": {
          "data": true
        }
      }
    }
  },
  "limits": {
    "worker_count": 2
  },
  "model": {
    "path": "models/Qwen2.5-1.5B-Instruct-Q4_K_M.gguf",
    "embedding_model": "models/nomic-embed-text-v1.5.Q4_K_M.gguf"
  }
}
