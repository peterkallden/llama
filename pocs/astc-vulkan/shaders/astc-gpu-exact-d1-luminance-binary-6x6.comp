#version 450

#include "astc-gpu-exact-pack.glsl"

// Legal normal ASTC 6x6 block subset: LDR luminance endpoints and a full
// 6x6 binary weight grid. This is intentionally a small exact packing mode.
layout(local_size_x = 64) in;

layout(std430, set = 0, binding = 0) readonly buffer Source { vec4 texels[]; } source;
layout(std430, set = 0, binding = 1) writeonly buffer Payloads { uvec4 values[]; } payloads;
layout(push_constant) uniform Push { uint block_count; uint texels_per_block; } params;

shared float values[64];

void main() {
    uint block = gl_WorkGroupID.x;
    if (block >= params.block_count || params.texels_per_block != 36u) return;
    uint lane = gl_LocalInvocationID.x;
    float value = lane < 36u ? source.texels[block * 36u + lane].r : 0.0;
    values[lane] = value;
    barrier();
    if (lane == 0u) {
        float low = values[0];
        float high = values[0];
        for (uint index = 1u; index < 36u; ++index) {
            low = min(low, values[index]);
            high = max(high, values[index]);
        }
        float threshold = 0.5 * (low + high);
        uint bytes[16] = uint[16](0u, 0u, 0u, 0u, 0u, 0u, 0u, 0u,
                                  0u, 0u, 0u, 0u, 0u, 0u, 0u, 0u);
        for (uint index = 0u; index < 36u; ++index) {
            astc_gpu_binary_ise_store(bytes, index,
                                      values[index] >= threshold ? 1u : 0u, 1u);
        }
        uvec4 payload = uvec4(0u);
        astc_gpu_emit_binary_ise_stream(payload, bytes);
        astc_gpu_write_normal_header(payload, astc_gpu_mode_d1_luminance_binary_6x6,
                                     astc_gpu_endpoint_format_luminance);
        astc_gpu_write_direct_luminance_endpoints(payload, astc_gpu_unorm8(low),
                                                   astc_gpu_unorm8(high));
        payloads.values[block] = payload;
    }
}
