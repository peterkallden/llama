#version 450

// D2 10x5 physical proposer: 50 RGBA texels, 1.28 bpw per logical weight.
// This deliberately has an explicit ABI; it must not reuse the 8x5 stride.
layout(local_size_x = 50) in;
layout(std430, set = 0, binding = 0) readonly buffer Source { vec4 texels[]; } source;
struct Proposal { vec4 endpoint_low; vec4 endpoint_high; float approximate_error; uint source_block_id; uint weight_grid_x; uint weight_grid_y; uint mode_family; };
layout(std430, set = 0, binding = 1) writeonly buffer Proposals { Proposal values[]; } proposals;
layout(std430, set = 0, binding = 2) readonly buffer SourceIds { uint values[]; } source_ids;
layout(push_constant) uniform Push { uint block_count; } params;
void main() {
    uint block = gl_WorkGroupID.x;
    if (block >= params.block_count || gl_LocalInvocationID.x != 0u) return;
    vec4 low = vec4(3.402823466e+38), high = vec4(-3.402823466e+38), mean = vec4(0.0);
    for (uint i = 0u; i < 50u; ++i) { vec4 value = source.texels[block * 50u + i]; low = min(low, value); high = max(high, value); mean += value; }
    mean *= 1.0 / 50.0;
    float error = 0.0;
    for (uint i = 0u; i < 50u; ++i) { vec4 d = source.texels[block * 50u + i] - mean; error += dot(d, d); }
    proposals.values[block].endpoint_low = low;
    proposals.values[block].endpoint_high = high;
    proposals.values[block].approximate_error = error / 50.0;
    proposals.values[block].source_block_id = source_ids.values[block];
    proposals.values[block].weight_grid_x = 10u;
    proposals.values[block].weight_grid_y = 5u;
    proposals.values[block].mode_family = 0u;
}
