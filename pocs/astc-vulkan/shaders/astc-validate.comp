#version 450

// Minimal sampled-image contract shader. It deliberately performs no model
// operation yet; it validates that an ASTC image can feed a compute shader.
layout(local_size_x = 64) in;

layout(set = 0, binding = 0) uniform sampler2D astc_weights;

layout(std430, set = 0, binding = 1) buffer ValidationOutput {
    vec4 values[];
};

layout(push_constant) uniform PushConstants {
    uint width;
    uint height;
    uint access_pattern;
} params;

void main() {
    const uint index = gl_GlobalInvocationID.x;
    const uint texel_count = params.width * params.height;
    if (index >= texel_count) {
        return;
    }

    uint sample_index = index;
    if (params.access_pattern != 0) {
        // A bijective permutation for the current 4x4 and 6x6 smoke images.
        // This intentionally defeats simple adjacent-texel locality without
        // changing the set of values that must be decoded.
        sample_index = (index * 7u + 3u) % texel_count;
    }
    const uint x = sample_index % params.width;
    const uint y = sample_index / params.width;
    values[index] = texelFetch(astc_weights, ivec2(x, y), 0);
}
