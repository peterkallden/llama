void main(){uint b=gl_WorkGroupID.x,l=gl_LocalInvocationID.x;if(b>=params.block_count||params.texels_per_block!=40u)return;values[l]=l<40u?vec2(source.texels[b*40u+l].r,source.texels[b*40u+l].a):vec2(0);barrier();if(l!=0u)return;float s[40];for(uint i=0u;i<40u;++i)s[i]=.5*(values[i].x+values[i].y);for(uint i=0u;i<40u;++i)for(uint j=i+1u;j<40u;++j)if(s[j]<s[i]){float t=s[i];s[i]=s[j];s[j]=t;}float split=.5*(s[10]+s[30]);vec2 lo=values[0],hi=values[0],sl=vec2(0),sh=vec2(0);uint nl=0u,nh=0u;for(uint i=0u;i<40u;++i){if(.5*(values[i].x+values[i].y)<split){sl+=values[i];++nl;}else{sh+=values[i];++nh;}}if(nl!=0u&&nh!=0u){lo=sl/float(nl);hi=sh/float(nh);}else{for(uint i=1u;i<40u;++i){lo=min(lo,values[i]);hi=max(hi,values[i]);}}uint lc=0u,hc=0u,la=0u,ha=0u;for(uint it=0u;it<3u;++it){lc=q8(lo.x);hc=q8(hi.x);la=q8(lo.y);ha=q8(hi.y);vec2 e0=vec2(lc,la)/255.,e1=vec2(hc,ha)/255.;sl=vec2(0);sh=vec2(0);nl=0u;nh=0u;for(uint i=0u;i<40u;++i){if(dot(values[i]-e1,values[i]-e1)<=dot(values[i]-e0,values[i]-e0)){sh+=values[i];++nh;}else{sl+=values[i];++nl;}}if(nl!=0u)lo=sl/float(nl);if(nh!=0u)hi=sh/float(nh);}lc=q8(lo.x);hc=q8(hi.x);la=q8(lo.y);ha=q8(hi.y);vec2 e0=vec2(lc,la)/255.,e1=vec2(hc,ha)/255.;uint wb[16]=uint[16](0u,0u,0u,0u,0u,0u,0u,0u,0u,0u,0u,0u,0u,0u,0u,0u);for(uint i=0u;i<40u;++i)if(dot(values[i]-e1,values[i]-e1)<=dot(values[i]-e0,values[i]-e0))wb[i>>3u]|=1u<<(i&7u);uvec4 p=uvec4(0);for(uint i=0u;i<16u;++i)bits(p,r8(wb[i]),8u,(15u-i)*8u);bits(p,0x065u,11u,0u);bits(p,4u,4u,13u);bits(p,lc,8u,17u);bits(p,hc,8u,25u);bits(p,la,8u,33u);bits(p,ha,8u,41u);payloads.values[b]=p;}
