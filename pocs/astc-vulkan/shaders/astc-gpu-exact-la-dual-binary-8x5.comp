#version 450

#include "astc-gpu-exact-pack.glsl"

// Legal D2-LA 8x5 dual-plane subset. The 5x4 binary grid supplies separate
// luminance and alpha weights; alpha is the second semantic D2 value.
layout(local_size_x = 64) in;
layout(std430, set = 0, binding = 0) readonly buffer Source { vec4 texels[]; } source;
layout(std430, set = 0, binding = 1) writeonly buffer Payloads { uvec4 values[]; } payloads;
layout(push_constant) uniform Push { uint block_count; uint texels_per_block; } params;
shared vec2 values[64];
void main() {
    uint block = gl_WorkGroupID.x;
    if (block >= params.block_count || params.texels_per_block != 40u) return;
    uint lane = gl_LocalInvocationID.x;
    values[lane] = lane < 40u ? vec2(source.texels[block * 40u + lane].r, source.texels[block * 40u + lane].a) : vec2(0.0);
    barrier();
    if (lane == 0u) {
        vec2 low = values[0]; vec2 high = values[0];
        for (uint index = 1u; index < 40u; ++index) { low = min(low, values[index]); high = max(high, values[index]); }
        vec2 range = high - low;
        uint bytes[16] = uint[16](0u, 0u, 0u, 0u, 0u, 0u, 0u, 0u, 0u, 0u, 0u, 0u, 0u, 0u, 0u, 0u);
        for (uint y = 0u; y < 4u; ++y) for (uint x = 0u; x < 5u; ++x) {
            uint source_x = (x * 7u + 2u) / 4u;
            uint source_y = (y * 4u + 1u) / 3u;
            vec2 sample_value = values[source_y * 8u + source_x];
            vec2 normalized = vec2(range.x > 0.0 ? (sample_value.x - low.x) / range.x : 0.0,
                                   range.y > 0.0 ? (sample_value.y - low.y) / range.y : 0.0);
            uint grid_index = y * 5u + x;
            astc_gpu_binary_ise_store(bytes, 2u * grid_index,
                                      normalized.x >= 0.5 ? 1u : 0u, 1u);
            astc_gpu_binary_ise_store(bytes, 2u * grid_index + 1u,
                                      normalized.y >= 0.5 ? 1u : 0u, 1u);
        }
        uvec4 payload = uvec4(0u);
        astc_gpu_emit_binary_ise_stream(payload, bytes);
        astc_gpu_write_normal_header(payload,
                                     astc_gpu_mode_d2_luminance_alpha_dual_binary_8x5,
                                     astc_gpu_endpoint_format_luminance_alpha);
        astc_gpu_write_direct_luminance_alpha_endpoints(
            payload, uvec2(astc_gpu_unorm8(low.x), astc_gpu_unorm8(low.y)),
            uvec2(astc_gpu_unorm8(high.x), astc_gpu_unorm8(high.y)));
        astc_gpu_payload_bits(payload, 3u, 2u, 86u);
        payloads.values[block] = payload;
    }
}
