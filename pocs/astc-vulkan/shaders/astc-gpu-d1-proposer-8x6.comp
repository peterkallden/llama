#version 450

// D1 scalar 8x6 proposal kernel with one texel per lane.
layout(local_size_x = 48) in;

layout(std430, set = 0, binding = 0) readonly buffer Source { vec4 texels[]; } source;
struct Proposal {
    vec4 endpoint_low;
    vec4 endpoint_high;
    float approximate_error;
    uint source_block_id;
    uint weight_grid_x;
    uint weight_grid_y;
    uint mode_family;
};
layout(std430, set = 0, binding = 1) writeonly buffer Proposals { Proposal values[]; } proposals;
layout(std430, set = 0, binding = 2) readonly buffer SourceIds { uint values[]; } source_ids;
layout(push_constant) uniform Push { uint block_count; } params;
shared vec4 lows[48]; shared vec4 highs[48]; shared vec4 sums[48]; shared float errors[48];

void main() {
    uint block = gl_WorkGroupID.x;
    if (block >= params.block_count) return;
    uint lane = gl_LocalInvocationID.x;
    vec4 value = source.texels[block * 48u + lane];
    lows[lane] = value; highs[lane] = value; sums[lane] = value;
    barrier();
    for (uint count = 48u; count > 1u; count = (count + 1u) / 2u) {
        uint next = (count + 1u) / 2u;
        if (lane < next && lane + next < count) { lows[lane] = min(lows[lane], lows[lane + next]); highs[lane] = max(highs[lane], highs[lane + next]); sums[lane] += sums[lane + next]; }
        barrier();
    }
    vec4 mean = sums[0] * (1.0 / 48.0); vec4 d = value - mean; errors[lane] = dot(d, d);
    barrier();
    for (uint count = 48u; count > 1u; count = (count + 1u) / 2u) { uint next = (count + 1u) / 2u; if (lane < next && lane + next < count) errors[lane] += errors[lane + next]; barrier(); }
    if (lane == 0u) { proposals.values[block].endpoint_low = lows[0]; proposals.values[block].endpoint_high = highs[0]; proposals.values[block].approximate_error = errors[0] / 48.0; proposals.values[block].source_block_id = source_ids.values[block]; proposals.values[block].weight_grid_x = 8u; proposals.values[block].weight_grid_y = 6u; proposals.values[block].mode_family = 0u; }
}
