#version 450

// D1 scalar 8x6 proposal kernel. Its explicit 48-lane ABI prevents a caller
// from accidentally applying a 4x4/5x5/6x6 source stride to the 2.67 bpw D1
// footprint. v1 intentionally uses one authoritative invocation for fitting;
// a parallel reduction is a later performance-only change.
layout(local_size_x = 48) in;

layout(std430, set = 0, binding = 0) readonly buffer Source { vec4 texels[]; } source;
struct Proposal {
    vec4 endpoint_low;
    vec4 endpoint_high;
    float approximate_error;
    uint source_block_id;
    uint weight_grid_x;
    uint weight_grid_y;
    uint mode_family;
};
layout(std430, set = 0, binding = 1) writeonly buffer Proposals { Proposal values[]; } proposals;
layout(std430, set = 0, binding = 2) readonly buffer SourceIds { uint values[]; } source_ids;
layout(push_constant) uniform Push { uint block_count; } params;

void main() {
    uint block = gl_WorkGroupID.x;
    if (block >= params.block_count || gl_LocalInvocationID.x != 0u) return;
    vec4 low = vec4(3.402823466e+38);
    vec4 high = vec4(-3.402823466e+38);
    vec4 mean = vec4(0.0);
    for (uint i = 0u; i < 48u; ++i) {
        vec4 value = source.texels[block * 48u + i];
        low = min(low, value);
        high = max(high, value);
        mean += value;
    }
    mean *= 1.0 / 48.0;
    float error = 0.0;
    for (uint i = 0u; i < 48u; ++i) {
        vec4 d = source.texels[block * 48u + i] - mean;
        error += dot(d, d);
    }
    proposals.values[block].endpoint_low = low;
    proposals.values[block].endpoint_high = high;
    proposals.values[block].approximate_error = error / 48.0;
    proposals.values[block].source_block_id = source_ids.values[block];
    proposals.values[block].weight_grid_x = 8u;
    proposals.values[block].weight_grid_y = 6u;
    proposals.values[block].mode_family = 0u;
}
