#version 450

// Isolated TQ1_0 control. Layout matches ggml block_tq1_0 (54 bytes per 256 values).
layout(local_size_x = 64) in;
layout(std430, set = 0, binding = 0) readonly buffer PackedWeights { uint data[]; } weights;
layout(std430, set = 0, binding = 1) buffer MatvecOutput { vec4 values[]; } output_data;
layout(push_constant) uniform PushConstants {
    uint width; uint height; uint access_pattern;
    float scale_l; float scale_a; float offset;
} params;

uint load_byte(uint byte_offset) {
    const uint word = weights.data[byte_offset >> 2];
    return (word >> ((byte_offset & 3u) * 8u)) & 0xffu;
}
float load_half(uint byte_offset) {
    const uint lo = load_byte(byte_offset);
    const uint hi = load_byte(byte_offset + 1u);
    return unpackHalf2x16(lo | (hi << 8u)).x;
}
uint pow3(uint exponent) {
    return exponent == 0u ? 1u : exponent == 1u ? 3u : exponent == 2u ? 9u : exponent == 3u ? 27u : 81u;
}
float activation(uint column) {
    return 0.5 * sin(0.017 * float(column + 1)) +
           0.2 * cos(0.031 * float(column + 3));
}
shared float partial[64];
void main() {
    const uint row = gl_WorkGroupID.x;
    if (row >= params.height) return;
    float sum = 0.0;
    for (uint column = gl_LocalInvocationID.x; column < params.width; column += 64u) {
        const uint block = row * (params.width / 256u) + column / 256u;
        const uint base = block * 54u;
        const uint within = column % 256u;
        uint byte_offset;
        uint digit;
        if (within < 160u) {
            digit = within / 32u;
            byte_offset = base + (within % 32u);
        } else if (within < 240u) {
            const uint residual = within - 160u;
            digit = residual / 16u;
            byte_offset = base + 32u + (residual % 16u);
        } else {
            const uint residual = within - 240u;
            digit = residual / 4u;
            byte_offset = base + 48u + (residual % 4u);
        }
        const uint trit = (load_byte(byte_offset) * pow3(digit)) & 0xffu;
        const uint code = (trit * 3u) >> 8u;
        const float weight = float(int(code) - 1) * load_half(base + 52u);
        sum += weight * activation(column);
    }
    partial[gl_LocalInvocationID.x] = sum;
    barrier();
    for (uint stride = 32u; stride > 0u; stride >>= 1u) {
        if (gl_LocalInvocationID.x < stride) partial[gl_LocalInvocationID.x] += partial[gl_LocalInvocationID.x + stride];
        barrier();
    }
    if (gl_LocalInvocationID.x == 0u) output_data.values[row] = vec4(partial[0], 0.0, 0.0, 0.0);
}
