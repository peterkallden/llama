{
  "schema_version": 1,
  "model": {"backend": "server-context", "path": "models/model.gguf"},
  "tools": {
    "profile": "all-configured",
    "families": {
      "eurostat": {
        "description": "Query Eurostat statistical datasets and JSON-stat data"
      }
    },
    "providers": [
      {
        "type": "openapi",
        "id": "eurostat-statistics",
        "enabled": true,
        "spec_path": "eurostat-statistics-openapi.json",
        "base_url": "https://ec.europa.eu/eurostat/api/dissemination/statistics/1.0",
        "prefix": "eurostat",
        "policy": {"access": "read_only", "exposure": "auto"},
        "auth": {"type": "none"}
      }
    ]
  }
}
