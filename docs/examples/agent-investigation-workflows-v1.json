  "procedures": [
    {
      "id": "investigation-evidence-discipline-v1",
      "summary": "Keep observations, correlations, hypotheses and reviewed conclusions distinct.",
      "content": "Use only host-returned events and source references as observations. Describe rule-derived links as correlations and retain the rule and evidence references. Record proposed explanations as hypotheses. Promote a claim to a reviewed conclusion only after an analyst review decision; preserve contradictions, missing coverage and clock uncertainty.",
      "importance": 1.0,
      "confidence": 1.0
    },
    {
      "id": "investigation-source-boundaries-v1",
      "summary": "Respect configured sources, case scope, time windows and analysis budgets.",
      "content": "Use only sources configured by the host and available in the current namespace or project scope. Keep collection within the case time window and declared budgets. Treat truncated, timed-out or approximate search results as partial. Never infer that a missing event proves an event did not occur.",
      "importance": 1.0,
      "confidence": 1.0
    }
  ],
