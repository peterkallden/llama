  "artifact_profiles": [
    {
      "id": "investigation_report",
      "revision": "v1",
      "title": "Investigation report",
      "purpose": "Present one immutable case revision with traceable evidence, supported and contradicted claims, and explicit gaps.",
      "sections": [
        {"id": "scope", "title": "Scope and method", "purpose": "Identify the case revision, source, time window and analysis method.", "required": true, "allowed_block_kinds": ["observation"]},
        {"id": "timeline", "title": "Timeline", "purpose": "List events in event-time order while retaining unknown and uncertain timestamps.", "required": true, "allowed_block_kinds": ["observation"]},
        {"id": "relations", "title": "Relations", "purpose": "Describe observed and rule-derived links with their evidence and derivation rules.", "required": true, "allowed_block_kinds": ["observation", "conclusion"]},
        {"id": "claims", "title": "Claims and alternatives", "purpose": "Separate hypotheses from reviewed conclusions and include supporting and contradicting evidence.", "required": true, "evidence_relations": ["supports", "contradicts", "qualifies"], "allowed_block_kinds": ["observation", "conclusion"]},
        {"id": "gaps", "title": "Gaps and limitations", "purpose": "Record partial searches, missing fields, coverage gaps and unresolved questions.", "required": true, "allowed_block_kinds": ["observation", "recommendation"]}
      ]
