pid /var/lib/llama-agent/nginx/nginx.pid;
error_log /dev/stderr notice;

events {}

http {
    include /etc/nginx/mime.types;
    access_log /dev/stdout;
    client_max_body_size 2m;
    client_body_temp_path /var/lib/llama-agent/nginx/client_body;
    proxy_temp_path /var/lib/llama-agent/nginx/proxy;
    fastcgi_temp_path /var/lib/llama-agent/nginx/fastcgi;
    uwsgi_temp_path /var/lib/llama-agent/nginx/uwsgi;
    scgi_temp_path /var/lib/llama-agent/nginx/scgi;

    server {
        listen 8080;
        server_name _;
        return 301 https://$host:8443$request_uri;
    }

    server {
        listen 8443 ssl;
        server_name _;
        ssl_certificate ${LLAMA_AGENT_TLS_CERT};
        ssl_certificate_key ${LLAMA_AGENT_TLS_KEY};
        root /opt/llama-agent-web/dist;
        index index.html;

        location / {
            try_files $uri $uri/ /index.html;
        }

        location /api/ {
            proxy_pass http://127.0.0.1:8090;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto https;
            proxy_set_header Authorization $http_authorization;
            proxy_buffering off;
            proxy_cache off;
            proxy_read_timeout 1h;
            proxy_send_timeout 1h;
            proxy_set_header Connection "";
        }
    }
}
